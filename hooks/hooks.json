{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-git.py\"",
            "statusMessage": "Checking for a destructive git command..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claim.py\"",
            "statusMessage": "Checking file claims..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-card.py\"",
            "statusMessage": "Checking the task card..."
          }
        ]
      }
    ]
  }
}
