{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\"",
            "statusMessage": "Reading the Mpi-Kanban board state..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact-handoff.py\"",
            "statusMessage": "Checking for work a handoff should preserve..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-git.py\"",
            "statusMessage": "Checking for a destructive git command..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-shell.py\"",
            "statusMessage": "Checking the shell command form..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-gpu.py\"",
            "statusMessage": "Checking the GPU lease..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claim.py\"",
            "statusMessage": "Checking file claims..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-card.py\"",
            "statusMessage": "Checking the task card..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-claim.py\"",
            "statusMessage": "Checking file claims..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-card.py\"",
            "statusMessage": "Checking the task card..."
          }
        ]
      }
    ]
  }
}
